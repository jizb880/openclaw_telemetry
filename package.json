{
  "name": "openclaw-otel-observability",
  "version": "0.1.0",
  "description": "Native OTLP tracing for OpenClaw (Action, Tool, LLM) with configurable capture flags — zero runtime dependencies",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \".test-build/test/**/*.test.js\"",
    "samples": "npm run build:test && node .test-build/scripts/generate-samples.js",
    "inspect": "npm run build:test && node .test-build/scripts/inspect-spans.js",
    "verify": "npm run typecheck && npm run test && npm run samples",
    "sync:host-hooks": "npm run build:test && node .test-build/scripts/sync-host-hooks.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.test-build',{recursive:true,force:true})\""
  },
  "keywords": [
    "openclaw",
    "opentelemetry",
    "otlp",
    "tracing",
    "llm",
    "observability"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
